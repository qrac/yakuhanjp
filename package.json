{
  "name": "yakuhanjp-monorepo",
  "version": "4.1.1",
  "private": true,
  "homepage": "https://yakuhanjp.qranoko.jp",
  "keywords": [
    "font",
    "webfont",
    "subset",
    "css",
    "japanese",
    "yakuhanjp"
  ],
  "author": {
    "name": "Qrac",
    "url": "https://qrac.jp"
  },
  "organization": {
    "name": "QRANOKO",
    "url": "https://qranoko.jp"
  },
  "scripts": {
    "build": "npm run build:main",
    "build:main": "cd ./packages/yakuhanjp && npm run build",
    "build:unicode": "cd ./packages/unicode && npm run build",
    "build:fonts": "uv run --locked python scripts/build_fonts.py",
    "test:fonts": "uv run --locked python -m unittest discover -s scripts -p 'test_*.py'",
    "test": "vitest run",
    "test:w": "vitest watch",
    "docs": "minista ./docs",
    "docs:build": "minista build ./docs",
    "docs:preview": "minista preview ./docs",
    "play": "npm run build && vite ./playground/_default",
    "play:canvas": "vite ./playground/canvas",
    "play:check": "tsc -p playground/tsconfig.json",
    "play:test": "node --test playground/canvas/src/*.test.ts",
    "audit": "npx npm-audit-trace",
    "up": "npx npm-check-updates --deep --cooldown 1",
    "up:u": "npx npm-check-updates --deep --cooldown 1 -u",
    "rev": "npx npm-replace-versions",
    "release": "npm run release:main",
    "release:main": "cd ./packages/yakuhanjp && npm publish"
  },
  "workspaces": [
    "docs",
    "packages/*",
    "playground/*"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "canvas": "^3.2.3",
    "clsx": "^2.1.1",
    "minista": "^5.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
